{
  "llm_model": "gpt-6-luna",
  "embedding_model": "text-embedding-3-small",
  "chunk_size": 1000,
  "chunk_overlap": 200,
  "top_k": 5,
  "search_type": "similarity",
  "fetch_k": 20,
  "max_queries": 4,
  "max_candidates": 30,
  "max_document_chars": 60000,
  "http_timeout": 8,
  "http_retries": 1,
  "request_interval": 3.1,
  "user_agent": "RobotLabRAG/2.0 (educational project)",
  "ingest_sources": [
    "wikipedia",
    "arxiv",
    "crossref",
    "semantic_scholar",
    "ieee"
  ],
  "question_sources": [
    "reddit",
    "patents",
    "ros",
    "wikidata"
  ]
}
